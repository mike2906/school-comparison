<?xml version="1.0" encoding="UTF-8"?>
<!-- Test network for frontend/src/routing/roadGraph.test.js. 3 x 3 grid, ~82 m by 111 m:
     7 8 9      top row is one-way east (7 -> 8 -> 9)
     4 5 6      bollard at 20, between 3 and 6
     1 2 3
     Restrictions: no right turn 1->4 then 4->5 (via node 4);
                   no turn from the bottom row via 2->5 onto 5->6 (via way).
     East block: 3 - 40, then 40 - 41 - 42 north (41 is a junction with a dead end to 43, 40 one
     to 46) and 42 - 9 back west. Only straight on from 3-40 via 40-41-42 onto 42-9 (via way). -->
<osm version="0.6">
  <node id="1" lat="42.700" lon="23.300"/>
  <node id="2" lat="42.700" lon="23.301"/>
  <node id="3" lat="42.700" lon="23.302"/>
  <node id="4" lat="42.701" lon="23.300"/>
  <node id="5" lat="42.701" lon="23.301"/>
  <node id="6" lat="42.701" lon="23.302"/>
  <node id="7" lat="42.702" lon="23.300"/>
  <node id="8" lat="42.702" lon="23.301"/>
  <node id="9" lat="42.702" lon="23.302"/>
  <node id="20" lat="42.7005" lon="23.302"><tag k="barrier" v="bollard"/></node>
  <node id="40" lat="42.700" lon="23.304"/>
  <node id="41" lat="42.701" lon="23.304"/>
  <node id="42" lat="42.702" lon="23.304"/>
  <node id="43" lat="42.701" lon="23.305"/>
  <node id="46" lat="42.700" lon="23.305"/>
  <way id="43"><nd ref="3"/><nd ref="40"/><tag k="highway" v="residential"/></way>
  <way id="41"><nd ref="40"/><nd ref="41"/><nd ref="42"/><tag k="highway" v="residential"/></way>
  <way id="42"><nd ref="41"/><nd ref="43"/><tag k="highway" v="residential"/></way>
  <way id="45"><nd ref="40"/><nd ref="46"/><tag k="highway" v="residential"/></way>
  <way id="44"><nd ref="42"/><nd ref="9"/><tag k="highway" v="residential"/></way>
  <way id="10"><nd ref="4"/><nd ref="5"/><tag k="highway" v="residential"/></way>
  <way id="16"><nd ref="5"/><nd ref="6"/><tag k="highway" v="residential"/></way>
  <way id="11"><nd ref="2"/><nd ref="5"/><tag k="highway" v="residential"/></way>
  <way id="17"><nd ref="5"/><nd ref="8"/><tag k="highway" v="residential"/></way>
  <way id="12"><nd ref="1"/><nd ref="2"/><tag k="highway" v="residential"/></way>
  <way id="19"><nd ref="2"/><nd ref="3"/><tag k="highway" v="residential"/></way>
  <way id="13"><nd ref="7"/><nd ref="8"/><nd ref="9"/><tag k="highway" v="residential"/><tag k="oneway" v="yes"/></way>
  <way id="14"><nd ref="1"/><nd ref="4"/><tag k="highway" v="residential"/></way>
  <way id="18"><nd ref="4"/><nd ref="7"/><tag k="highway" v="residential"/></way>
  <way id="15"><nd ref="3"/><nd ref="20"/><nd ref="6"/><nd ref="9"/><tag k="highway" v="residential"/></way>
  <relation id="30">
    <member type="way" ref="14" role="from"/><member type="node" ref="4" role="via"/>
    <member type="way" ref="10" role="to"/>
    <tag k="type" v="restriction"/><tag k="restriction" v="no_right_turn"/>
  </relation>
