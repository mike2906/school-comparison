# Production stack settings. Copy to deploy/.env (gitignored) and pass it explicitly:
#   docker compose --env-file deploy/.env -f docker-compose.prod.yml up -d

# Hostname Caddy serves the API on. The frontend build uses the same host in
# VITE_API_BASE and PRERENDER_API_URL (https://<API_HOST>).
API_HOST=api.schooldecider.com

# Caddy `tls` arguments. Production: the Cloudflare Origin CA certificate and key, mounted
# read-only from ORIGIN_CERT_DIR. Local runs: `internal` (Caddy's own CA; use `curl -k`).
CADDY_TLS=/certs/origin.pem /certs/origin.key
# Host directory holding origin.pem and origin.key.
ORIGIN_CERT_DIR=./deploy/certs

# Frontend origin(s) allowed by CORS, comma-separated, no trailing slash.
ALLOWED_ORIGINS=https://schooldecider.com

# Goes into DATABASE_URL unescaped, so it must be URL-safe: generate it with
# `openssl rand -hex 32`. Postgres only reads it when the data volume is first created.
POSTGRES_PASSWORD=

# Launch-scope publication flags (fail-closed: unset means false).
PUBLISH_SUMMARIES=false
PUBLISH_WEBSITE_ADMISSION_FIELDS=false
PUBLISH_WEBSITE_DYNAMIC_FIELDS=false

# Optional. Uvicorn worker processes (default 1).
# WEB_CONCURRENCY=1
# Host address and ports Caddy binds. Production binds IPv4 only: the host firewall
# (deploy/firewall.sh) limits 443 to Cloudflare's IPv4 ranges and has no IPv6 rules.
# Local runs: e.g. HTTP_PORT=8081 and HTTPS_PORT=8443.
HTTP_PORT=0.0.0.0:80
HTTPS_PORT=0.0.0.0:443
