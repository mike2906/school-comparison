  "welcome": {
    "title": "Find a kindergarten or school in Sofia",
    "body": "Tell us your child’s birth year to see only the groups they can join, or search a school by name.",
    "cta": "Choose birth year",
    "dismiss": "Dismiss"
  },
  "about": {
    "title": "About the data",
    "intro": "This site brings together public information about kindergartens and schools in Sofia so you can compare them in one place.",
    "sourcesTitle": "Where the data comes from",
    "sources": {
      "schools": {
        "title": "Schools and their addresses",
        "body": "The Ministry of Education and Science register of schools and kindergartens: names, types, grades and addresses."
      },
      "kindergartens": {
        "title": "Municipal kindergartens",
        "body": "Sofia Municipality’s kindergarten enrolment system: kindergartens, their groups and locations.",
        "coverage": "We list all municipal kindergartens and nurseries published on Sofia Municipality’s system (about 200 kindergartens and 25 nurseries), plus the state kindergartens run by the Ministry of Defence. Where we could not place an address precisely, the kindergarten is listed without a map pin or distance. Applications and places are handled at kg.sofia.bg."
      },
      "nvo": {
        "title": "NVO exam results",
        "body": "Official results of the national external assessments (NVO) for 4th, 7th and 10th grade, published by the Ministry of Education and Science as open data. We show each school’s average in Bulgarian and maths, and the average of the Sofia schools’ results for the same exam and year."
      },
      "prices": {
        "title": "Private school fees",
        "body": "Taken from each school’s own website and shown only where the page states the price. Every price is marked with its source, and the comparison page links to the page it came from and shows when we checked it. Fees change, so confirm with the school before deciding."
      },
      "maps": {
        "title": "Maps and distances",
        "body": "School locations are placed on the map with OpenStreetMap data; map tiles by CARTO. Distances are straight-line, not travel distance."
      }
    },
    "ageTitle": "How age groups are worked out",
    "ageBody": "In Bulgaria the group depends on the calendar year of birth, not the exact birthday: group = enrolment year − birth year. Children born on 1 January and 31 December of the same year join the same group.",
    "limitsTitle": "What is not here yet",
    "limitsBody": "Admission thresholds (kindergarten points and gymnasium minimum scores) are not published yet. Where we have no reliable data we leave the field out rather than guess.",
    "privacyTitle": "Privacy",
    "privacy": {
