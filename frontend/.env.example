# CARTO basemaps key (https://carto.com/basemaps/apikey). Sent to browsers in tile URLs,
# so restrict it to your domains in the CARTO dashboard. Without it tiles show a watermark.
VITE_CARTO_API_KEY=

# Public origin of the site, without a trailing slash. Used for absolute canonical, hreflang
# and sitemap URLs. `npm run build:production` fails unless it is set and https.
VITE_SITE_ORIGIN=https://schooldecider.bg

# API the build reads school data from to prerender school pages (build time only, not
# sent to browsers). Unset: `npm run build` writes the fixed pages only;
# `npm run build:production` fails.
PRERENDER_API_URL=
