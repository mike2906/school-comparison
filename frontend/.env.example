# CARTO basemaps key (https://carto.com/basemaps/apikey). Sent to browsers in tile URLs,
# so restrict it to your domains in the CARTO dashboard. Without it tiles show a watermark.
VITE_CARTO_API_KEY=

# Public origin of the site, without a trailing slash. Used for absolute hreflang URLs.
# Placeholder until the domain is registered.
VITE_SITE_ORIGIN=https://schooldecider.bg
