# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sofia_schools

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenRouter (for AI features - Phase 3)
OPENROUTER_API_KEY=your-openrouter-api-key

# App settings
# Defaults to false; set true only for local development.
DEBUG=true
DATABASE_ECHO=false
# Comma-separated; in production set this to the deployed frontend origin(s).
ALLOWED_ORIGINS=http://localhost:5173

# Scraping settings
SCRAPE_DELAY_SECONDS=2
WEBSITE_SEARCH_PROVIDERS=searxng,brave
SEARXNG_BASE_URL=http://localhost:8080
WEBSITE_SEARCH_TIMEOUT_SECONDS=6
WEBSITE_SEARCH_PROVIDER_DISABLE_SECONDS=300
URL_VALIDATION_HTTP_TIMEOUT_SECONDS=4
URL_VALIDATION_RETRY_HTTP_TIMEOUT_SECONDS=8
URL_VALIDATION_TIMEOUT_TERMINAL_THRESHOLD=3
URL_VALIDATION_CONCURRENCY=4
URL_VALIDATION_MAX_CONCURRENCY=8
URL_VALIDATION_LLM_TIMEOUT_SECONDS=25
URL_RECOVERY_CANDIDATE_ATTEMPTS=6
URL_RECOVERY_CONCURRENCY=3
EXTRACTION_LLM_TIMEOUT_SECONDS=45
EXTRACTION_LLM_RETRY_TIMEOUT_SECONDS=90
EXTRACTION_LLM_TIMEOUT_RETRIES=2
EXTRACTION_MAX_CONTENT_CHARS=15000
EXTRACTION_GENERAL_INFO_MIN_QUALITY_SCORE=4
EXTRACTION_OUTPUT_RETRIES=2
EXTRACTION_TEMPERATURE=0.0
EXTRACTION_OPENROUTER_MODELS=openai/gpt-4o-mini
EXTRACTION_OPENROUTER_PROVIDER_ORDER=
EXTRACTION_OPENROUTER_PROVIDER_ALLOW_FALLBACKS=true
EXTRACTION_OPENROUTER_PROVIDER_SORT=
EXTRACTION_BATCH_CONCURRENCY=1
EXTRACTION_CLEAR_PRICING_ON_NO_INFO=false
NAV_BATCH_CONCURRENCY=3
VALIDATION_BATCH_CONCURRENCY=3
VALIDATION_SPOT_CHECK_TIMEOUT_SECONDS=20
VALIDATION_SPOT_CHECK_MAX_CONTENT_CHARS=12000
VALIDATION_SPOT_CHECK_MAX_EXTRACTED_CHARS=8000

# Geocoding settings
GEOCODING_PROVIDER=nominatim
# REQUIRED: Replace with your actual email (Nominatim policy requires valid contact)
GEOCODING_CONTACT_EMAIL=your-email@example.com

MODEL_TIER_CHEAP=openrouter/google/gemini-2.5-flash-lite
MODEL_TIER_CAPABLE=openrouter/openai/gpt-4o-mini
